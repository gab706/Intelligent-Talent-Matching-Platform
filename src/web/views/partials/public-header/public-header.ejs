<link rel="stylesheet" href="/partials/public-header/public-header.css" />
<%
    const headerIsAuthenticated = typeof isAuthenticated !== 'undefined' && isAuthenticated;
    const headerIsAccountHomePage = typeof isAccountHomePage !== 'undefined' && isAccountHomePage;
    const headerAccountType = typeof accountType !== 'undefined' ? accountType : undefined;
    const headerCurrentPath = typeof currentPath !== 'undefined' ? currentPath : '';
    const showAccountHeader = headerIsAuthenticated && !headerIsAccountHomePage;
    const showAccountHomeHeader = headerIsAuthenticated && headerIsAccountHomePage;
    const isCandidateAccount = headerAccountType === 1;
    const isEmployerAccount = headerAccountType === 2;
    const isFlexAccount = headerAccountType === 3;
    const renderedAvatarPath = typeof avatarPath !== 'undefined' && avatarPath ? avatarPath : '/images/avatar/default.png';
    const renderedFullName = typeof fullName !== 'undefined' && fullName ? fullName : 'Your account';
    const renderedEmail = typeof email !== 'undefined' && email ? email : '';
    const renderedPhone = typeof phone !== 'undefined' && phone ? phone : '';
    const renderedIsMember = typeof isMember !== 'undefined' && isMember;
    const renderedIsAdmin = typeof isAdmin !== 'undefined' && isAdmin;
    const renderedAccountLabel = typeof accountLabel !== 'undefined' && accountLabel ? accountLabel : 'Candidate';
    const renderedNotifications = typeof notifications !== 'undefined' && notifications ? notifications : [];
    const renderedUnreadNotificationCount = typeof unreadNotificationCount !== 'undefined' ? unreadNotificationCount : 0;
    const renderedIsImpersonating = typeof isImpersonating !== 'undefined' && isImpersonating;
    const renderedImpersonatedUserName = typeof impersonatedUserName !== 'undefined' && impersonatedUserName ? impersonatedUserName : 'this user';
    const accountHomeHref = headerCurrentPath.startsWith('/employer') ? '/employer/home' : '/candidate/home';
%>
<% if (renderedIsImpersonating) { %>
<div class="public-header__impersonation-banner" role="status" data-impersonation-banner>
    <button class="public-header__impersonation-pin" type="button" aria-label="Minimise impersonation banner" data-impersonation-pin>
        <i class="fas fa-thumbtack" aria-hidden="true"></i>
    </button>
    <span>You are viewing the page as "<%= renderedImpersonatedUserName %>"</span>
    <form method="post" action="/admin/impersonation-stop" aria-label="Return to main account">
        <button class="public-header__impersonation-close" type="submit" aria-label="Return to main account">
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
    </form>
</div>
<% } %>
<header class="public-header">
    <nav class="public-header__nav" aria-label="Public navigation">
        <a href="<%= showAccountHomeHeader ? accountHomeHref : '/index' %>" class="public-header__brand" aria-label="TalentMatch Home">
         <span class="public-header__logo-wrapper">
            <i class="fas fa-eye public-header__logo" aria-hidden="true"></i>
         </span>
            <span class="public-header__brand-text">
         <span class="public-header__brand-title">TalentMatch</span>
         <span class="public-header__brand-subtitle">ITMP Platform</span>
         </span>
        </a>
        <div class="public-header__right">
            <div id="public-mobile-menu" class="public-header__menu" data-mobile-menu>
                <% if (showAccountHomeHeader) { %>
                <ul class="public-header__links public-header__links--empty" aria-hidden="true"></ul>
                <div class="public-header__actions public-header__actions--account-home">
                    <div class="public-header__link-item public-header__link-item--dropdown public-header__notification-menu">
                        <button class="public-header__notification-toggle" type="button" aria-label="Open notifications" aria-expanded="false" data-public-dropdown>
                            <i class="fas fa-bell" aria-hidden="true"></i>
                            <% if (renderedUnreadNotificationCount > 0) { %>
                            <span class="public-header__notification-badge" data-notification-badge>
                                <%= renderedUnreadNotificationCount %>
                            </span>
                            <% } %>
                        </button>
                        <div class="public-header__dropdown public-header__notification-dropdown" data-public-dropdown-menu>
                            <div class="public-header__notification-list" data-notification-list>
                                <% if (renderedNotifications.length) { %>
                                    <% renderedNotifications.forEach((notification) => { %>
                                    <% if (notification.isRead) { %>
                                    <button class="public-header__notification-item public-header__notification-item--read" type="button" disabled>
                                    <% } else { %>
                                    <button class="public-header__notification-item public-header__notification-item--unread" type="button" data-notification-read data-notification-id="<%= notification.id %>">
                                    <% } %>
                                        <img class="public-header__notification-avatar" src="<%= notification.avatarPath || '/images/avatar/default.png' %>" alt="" />
                                        <span class="public-header__notification-copy">
                                            <strong><%= notification.title %></strong>
                                            <span><%= notification.message %></span>
                                        </span>
                                    </button>
                                    <% }); %>
                                <% } else { %>
                                <p class="public-header__notification-empty">
                                    No New Notifications
                                </p>
                                <% } %>
                            </div>
                            <div class="public-header__notification-actions" data-notification-actions>
                                <% if (renderedNotifications.length) { %>
                                <a class="public-header__notification-action" href="#" data-notification-clear-all>
                                    Clear all
                                </a>
                                <% } else { %>
                                <span class="public-header__notification-action is-disabled" aria-disabled="true" data-notification-clear-all-disabled>
                                    Clear all
                                </span>
                                <% } %>
                                <% if (renderedUnreadNotificationCount > 0) { %>
                                <a class="public-header__notification-action" href="#" data-notification-read-all>
                                    Mark all as read
                                </a>
                                <% } else { %>
                                <span class="public-header__notification-action is-disabled" aria-disabled="true" data-notification-read-all-disabled>
                                    Mark all as read
                                </span>
                                <% } %>
                            </div>
                        </div>
                    </div>
                    <div class="public-header__link-item public-header__link-item--dropdown public-header__avatar-menu">
                        <button class="public-header__avatar-toggle" type="button" aria-label="Open account menu" aria-expanded="false" data-public-dropdown>
                            <img src="<%= renderedAvatarPath %>" alt="Your avatar" />
                            <i class="fas fa-chevron-down public-header__avatar-chevron" aria-hidden="true"></i>
                        </button>
                        <div class="public-header__dropdown public-header__account-dropdown" data-public-dropdown-menu>
                            <div class="public-header__account-summary">
                                <div class="public-header__account-name-row">
                                    <strong class="public-header__account-name <%= renderedIsAdmin ? 'public-header__account-name--admin' : '' %>">
                                        <%= renderedFullName %>
                                    </strong>
                                    <% if (renderedIsAdmin) { %>
                                    <span class="public-header__role-tag">
                                        Admin
                                        <i class="fas fa-crown" aria-hidden="true"></i>
                                    </span>
                                    <% } %>
                                </div>
                                <% if (renderedEmail) { %>
                                <span class="public-header__account-email">
                                    <%= renderedEmail %>
                                </span>
                                <% } %>
                            </div>
                            <button class="public-header__dropdown-link public-header__dropdown-button" type="button" data-profile-open>
                                Account Settings
                            </button>
                            <label class="public-header__theme-switch">
                                <span>Dark Theme</span>
                                <input type="checkbox" <%= theme === 'DARK' ? 'checked' : '' %> data-theme-toggle />
                                <span class="public-header__theme-slider" aria-hidden="true"></span>
                            </label>
                            <a class="public-header__dropdown-link public-header__dropdown-link--logout" href="/logout">
                                Logout
                            </a>
                        </div>
                    </div>
                </div>
                <% } else { %>
                <ul class="public-header__links">
                    <% if (showAccountHeader && isCandidateAccount) { %>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/candidate/home">Candidate Home</a>
                    </li>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/candidate/find-a-job">Find a Job</a>
                    </li>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/companies">Companies</a>
                    </li>
                    <% } else if (showAccountHeader && isEmployerAccount) { %>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/employer/home">Employer Home</a>
                    </li>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/employer/find-a-candidate">Find a Candidate</a>
                    </li>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/companies">Companies</a>
                    </li>
                    <% } else { %>
                    <li class="public-header__link-item public-header__link-item--dropdown">
                        <button class="public-header__link public-header__dropdown-trigger" type="button" aria-expanded="false" data-public-dropdown>
                            For Candidates
                            <i class="fas fa-chevron-down" aria-hidden="true"></i>
                        </button>
                        <div class="public-header__dropdown" data-public-dropdown-menu>
                            <% if (showAccountHeader && isFlexAccount) { %>
                            <a class="public-header__dropdown-link" href="/candidate/home">
                                Candidate Home
                            </a>
                            <% } %>
                            <a class="public-header__dropdown-link" href="/candidate/find-a-job">
                                Find a Job
                            </a>
                            <a class="public-header__dropdown-link" href="<%= showAccountHeader && isFlexAccount ? '/candidate/profile' : '/candidate/register' %>">
                                Build your Profile
                            </a>
                        </div>
                    </li>
                    <li class="public-header__link-item public-header__link-item--dropdown">
                        <button class="public-header__link public-header__dropdown-trigger" type="button" aria-expanded="false" data-public-dropdown>
                            For Employers
                            <i class="fas fa-chevron-down" aria-hidden="true"></i>
                        </button>
                        <div class="public-header__dropdown" data-public-dropdown-menu>
                            <% if (showAccountHeader && isFlexAccount) { %>
                            <a class="public-header__dropdown-link" href="/employer/home">
                                Employer Home
                            </a>
                            <% } %>
                            <a class="public-header__dropdown-link" href="/employer/find-a-candidate">
                                Find a Candidate
                            </a>
                            <a class="public-header__dropdown-link" href="<%= showAccountHeader && isFlexAccount ? '/employer/companies' : '/employer/register' %>">
                                Build your Company Profile
                            </a>
                        </div>
                    </li>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/companies">Companies</a>
                    </li>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/membership">Membership</a>
                    </li>
                    <% } %>
                </ul>
                <div class="public-header__actions">
                    <button class="public-header__help-toggle" type="button" aria-label="About TalentMatch" data-help-open>
                        <i class="fas fa-question" aria-hidden="true"></i>
                    </button>
                    <% if (showAccountHeader) { %>
                    <div class="public-header__link-item public-header__link-item--dropdown public-header__avatar-menu">
                        <button class="public-header__avatar-toggle" type="button" aria-label="Open account menu" aria-expanded="false" data-public-dropdown>
                            <img src="<%= renderedAvatarPath %>" alt="Your avatar" />
                            <i class="fas fa-chevron-down public-header__avatar-chevron" aria-hidden="true"></i>
                        </button>
                        <div class="public-header__dropdown public-header__account-dropdown" data-public-dropdown-menu>
                            <div class="public-header__account-summary">
                                <div class="public-header__account-name-row">
                                    <strong class="public-header__account-name <%= renderedIsAdmin ? 'public-header__account-name--admin' : '' %>">
                                        <%= renderedFullName %>
                                    </strong>
                                    <% if (renderedIsAdmin) { %>
                                    <span class="public-header__role-tag">
                                        Admin
                                        <i class="fas fa-crown" aria-hidden="true"></i>
                                    </span>
                                    <% } %>
                                </div>
                                <% if (renderedEmail) { %>
                                <span class="public-header__account-email">
                                    <%= renderedEmail %>
                                </span>
                                <% } %>
                            </div>
                            <button class="public-header__dropdown-link public-header__dropdown-button" type="button" data-profile-open>
                                Account Settings
                            </button>
                            <label class="public-header__theme-switch">
                                <span>Dark Theme</span>
                                <input type="checkbox" <%= theme === 'DARK' ? 'checked' : '' %> data-theme-toggle />
                                <span class="public-header__theme-slider" aria-hidden="true"></span>
                            </label>
                            <a class="public-header__dropdown-link public-header__dropdown-link--logout" href="/logout">
                                Logout
                            </a>
                        </div>
                    </div>
                    <% } else { %>
                    <button class="public-header__theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
                        <i class="<%= theme === 'DARK' ? 'fas fa-moon' : 'fas fa-sun' %>" aria-hidden="true"></i>
                    </button>
                    <% } %>
                </div>
                <% } %>
            </div>
            <button class="public-header__mobile-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="public-mobile-menu" data-mobile-menu-toggle>
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
        </div>
    </nav>
</header>
<div class="public-header-modal" aria-hidden="true" data-help-modal>
    <div class="public-header-modal__overlay" data-help-close></div>
    <section class="public-header-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="public-help-title">
        <button class="public-header-modal__close" type="button" aria-label="Close" data-help-close>
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <p class="public-header-modal__eyebrow">
            About TalentMatch
        </p>
        <h2 id="public-help-title" class="public-header-modal__title">
            Smarter matching for candidates and employers.
        </h2>
        <p class="public-header-modal__text">
            TalentMatch helps candidates build searchable profiles and helps employers
            discover people who better match the role, skills, preferences, and experience
            they need.
        </p>
    </section>
</div>
<% if (headerIsAuthenticated) { %>
<div class="public-profile-modal" aria-hidden="true" data-profile-modal>
    <div class="public-profile-modal__overlay"></div>
    <section class="public-profile-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="public-profile-title">
        <button class="public-profile-modal__close" type="button" aria-label="Close profile" data-profile-close>
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <p class="public-profile-modal__eyebrow">
            Account Settings
        </p>
        <h2 id="public-profile-title" class="public-profile-modal__title">
            Account settings
        </h2>
        <form class="public-profile-modal__form" data-profile-form>
            <label class="public-profile-modal__avatar" for="public-profile-avatar">
                <img src="<%= renderedAvatarPath %>" alt="Current avatar" data-profile-avatar-preview />
                <span>
                    Change avatar
                </span>
                <input id="public-profile-avatar" name="avatar" type="file" accept=".jpg,.jpeg,.png,.heic,image/jpeg,image/png,image/heic,image/heif" data-profile-avatar-input />
            </label>
            <div class="public-profile-modal__settings-pair">
                <div class="public-profile-modal__setting public-profile-modal__setting--account">
                    <span class="public-profile-modal__setting-label">Account type</span>
                    <strong class="public-profile-modal__setting-value"><%= renderedAccountLabel %></strong>
                </div>
                <label class="public-profile-modal__setting public-profile-modal__setting--membership">
                    <span class="public-profile-modal__setting-label">
                        Membership subscription
                    </span>
                    <input type="checkbox" name="membershipSubscription" <%= renderedIsMember ? 'checked' : '' %> />
                    <span class="public-profile-modal__membership-slider" aria-hidden="true"></span>
                </label>
            </div>
            <div class="public-profile-modal__grid">
                <label class="public-profile-modal__field" for="public-profile-first-name">
                    <span>First name</span>
                    <input id="public-profile-first-name" name="firstName" type="text" autocomplete="given-name" value="<%= typeof firstName !== 'undefined' ? firstName : '' %>" required />
                </label>
                <label class="public-profile-modal__field" for="public-profile-last-name">
                    <span>Last name</span>
                    <input id="public-profile-last-name" name="lastName" type="text" autocomplete="family-name" value="<%= typeof lastName !== 'undefined' ? lastName : '' %>" required />
                </label>
            </div>
            <label class="public-profile-modal__field" for="public-profile-email">
                <span>Email</span>
                <input id="public-profile-email" name="email" type="email" autocomplete="email" value="<%= renderedEmail %>" required />
            </label>
            <label class="public-profile-modal__field" for="public-profile-phone">
                <span>Phone</span>
                <input id="public-profile-phone" name="phone" type="tel" autocomplete="tel" value="<%= renderedPhone %>" required />
            </label>
            <div class="public-profile-modal__password-group">
                <p>Change password</p>
                <label class="public-profile-modal__field" for="public-profile-old-password">
                    <span>Old password</span>
                    <input id="public-profile-old-password" name="oldPassword" type="password" autocomplete="current-password" />
                </label>
                <label class="public-profile-modal__field" for="public-profile-new-password">
                    <span>New password</span>
                    <input id="public-profile-new-password" name="newPassword" type="password" autocomplete="new-password" />
                </label>
                <label class="public-profile-modal__field" for="public-profile-confirm-password">
                    <span>Confirm new password</span>
                    <input id="public-profile-confirm-password" name="confirmPassword" type="password" autocomplete="new-password" />
                </label>
            </div>
            <button class="public-profile-modal__save" type="submit" data-profile-save>
                Save
            </button>
        </form>
    </section>
</div>
<% } %>
<script data-cfasync="false" src="/partials/public-header/public-header.js?v=20260616-profile-upload-2"></script>
