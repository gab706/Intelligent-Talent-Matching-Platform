<link rel="stylesheet" href="/partials/public-header/public-header.css" />
<header class="public-header">
    <nav class="public-header__nav" aria-label="Public navigation">
        <a href="/index" class="public-header__brand" aria-label="TalentMatch Home">
         <span class="public-header__logo-wrapper">
            <i class="fas fa-eye public-header__logo" aria-hidden="true"></i>
         </span>
            <span class="public-header__brand-text">
         <span class="public-header__brand-title">TalentMatch</span>
         <span class="public-header__brand-subtitle">ITMP Platform</span>
         </span>
        </a>
        <div class="public-header__right">
            <div id="public-mobile-menu" class="public-header__menu" data-mobile-menu>
                <ul class="public-header__links">
                    <li class="public-header__link-item public-header__link-item--dropdown">
                        <button class="public-header__link public-header__dropdown-trigger" type="button" aria-expanded="false" data-public-dropdown>
                            For Candidates
                            <i class="fas fa-chevron-down" aria-hidden="true"></i>
                        </button>
                        <div class="public-header__dropdown" data-public-dropdown-menu>
                            <a class="public-header__dropdown-link" href="/candidate/find-a-job">
                                Find a Job
                            </a>
                            <a class="public-header__dropdown-link" href="/candidate/register">
                                Build your Profile
                            </a>
                        </div>
                    </li>
                    <li class="public-header__link-item public-header__link-item--dropdown">
                        <button class="public-header__link public-header__dropdown-trigger" type="button" aria-expanded="false" data-public-dropdown>
                            For Employers
                            <i class="fas fa-chevron-down" aria-hidden="true"></i>
                        </button>
                        <div class="public-header__dropdown" data-public-dropdown-menu>
                            <a class="public-header__dropdown-link" href="/employer/find-a-candidate">
                                Find a Candidate
                            </a>
                            <a class="public-header__dropdown-link" href="/employer/register">
                                Build your Company Profile
                            </a>
                        </div>
                    </li>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/candidate/companies">Companies</a>
                    </li>
                    <li class="public-header__link-item">
                        <a class="public-header__link" href="/membership">Membership</a>
                    </li>
                </ul>
                <div class="public-header__actions">
                    <button class="public-header__help-toggle" type="button" aria-label="About TalentMatch" data-help-open>
                        <i class="fas fa-question" aria-hidden="true"></i>
                    </button>
                    <button class="public-header__theme-toggle" type="button" aria-label="Toggle dark mode" data-theme-toggle>
                        <i class="<%= theme === 'DARK' ? 'fas fa-moon' : 'fas fa-sun' %>" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
            <button class="public-header__mobile-toggle" type="button" aria-label="Open navigation menu" aria-expanded="false" aria-controls="public-mobile-menu" data-mobile-menu-toggle>
                <i class="fas fa-bars" aria-hidden="true"></i>
            </button>
        </div>
    </nav>
</header>
<div class="public-header-modal" aria-hidden="true" data-help-modal>
    <div class="public-header-modal__overlay" data-help-close></div>
    <section class="public-header-modal__dialog" role="dialog" aria-modal="true" aria-labelledby="public-help-title">
        <button class="public-header-modal__close" type="button" aria-label="Close" data-help-close>
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <p class="public-header-modal__eyebrow">
            About TalentMatch
        </p>
        <h2 id="public-help-title" class="public-header-modal__title">
            Smarter matching for candidates and employers.
        </h2>
        <p class="public-header-modal__text">
            TalentMatch helps candidates build searchable profiles and helps employers
            discover people who better match the role, skills, preferences, and experience
            they need.
        </p>
    </section>
</div>
<script src="/partials/public-header/public-header.js"></script>
