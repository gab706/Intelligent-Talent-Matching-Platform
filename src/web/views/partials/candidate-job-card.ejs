<%
    const saved = savedJobIds.includes(job.id);
    const applied = appliedJobIds.includes(job.id);
    const appliedInfo = appliedJobs && appliedJobs[job.id];
%>
<article class="find-job-page__job-card" data-job-card data-job-id="<%= job.id %>">
    <div class="find-job-page__job-main">
        <div>
            <h3><%= job.jobTitle %></h3>
            <p class="find-job-page__company">
                <%= job.companyName %>
                <% if (job.companyIndustry) { %>
                <span>| <%= job.companyIndustry %></span>
                <% } %>
            </p>
        </div>
        <% if (showScore) { %>
        <strong class="find-job-page__score"><%= job.score %>%</strong>
        <% } %>
    </div>

    <div class="find-job-page__meta">
        <span><i class="fas fa-map-marker-alt" aria-hidden="true"></i><%= job.jobLocation %></span>
        <span><i class="fas fa-briefcase" aria-hidden="true"></i><%= job.workMode ? job.workMode.replace('_', ' ') : 'Work mode not set' %></span>
        <% if (job.jobType) { %>
        <span><i class="fas fa-clock" aria-hidden="true"></i><%= job.jobType.replace('_', ' ') %></span>
        <% } %>
        <% if (appliedInfo) { %>
        <span class="find-job-page__applied-meta"><i class="fas fa-calendar-check" aria-hidden="true"></i>Applied <span data-local-date="<%= appliedInfo.appliedAt %>"><%= appliedInfo.appliedAt %></span></span>
        <% } %>
    </div>

    <div class="find-job-page__actions">
        <% if (!applied) { %>
        <button class="find-job-page__apply" type="button" data-apply-job="<%= job.id %>">
            <i class="fas fa-paper-plane" aria-hidden="true"></i>
            Apply
        </button>
        <% if (saved) { %>
        <button type="button" data-unsave-job="<%= job.id %>">
            <i class="fas fa-bookmark" aria-hidden="true"></i>
            Unsave
        </button>
        <% } else { %>
        <button type="button" data-save-job="<%= job.id %>">
            <i class="<%= saved ? 'fas fa-bookmark' : 'far fa-bookmark' %>" aria-hidden="true"></i>
            Save
        </button>
        <% } %>
        <% } %>
        <button type="button" data-view-job="<%= job.id %>">
            <i class="fas fa-eye" aria-hidden="true"></i>
            View
        </button>
    </div>
</article>
