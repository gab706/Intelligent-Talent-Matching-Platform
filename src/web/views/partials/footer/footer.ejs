<link rel="stylesheet" href="/partials/footer/footer.css" />
<footer class="tm-footer">
    <div class="tm-footer__inner">
        <section class="tm-footer__brand-column">
            <a href="/index" class="tm-footer__brand" aria-label="TalentMatch Home">
            <span class="tm-footer__logo-wrapper">
               <svg class="tm-footer__logo" viewBox="0 0 64 64" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                  <circle cx="20" cy="22" r="8" />
                  <circle cx="44" cy="22" r="8" />
                  <circle cx="32" cy="46" r="8" />
                  <path d="M27 26L37 42" />
                  <path d="M37 26L27 42" />
                  <path d="M28 22H36" />
               </svg>
            </span>
                <span class="tm-footer__brand-text">
            <span class="tm-footer__brand-title">
            TalentMatch
            </span>
            <span class="tm-footer__brand-subtitle">
            ITMP Platform
            </span>
            </span>
            </a>
            <p class="tm-footer__description">
                Intelligent recruitment matching for candidates
                and employers using profile and job relevance scoring.
            </p>
        </section>
        <nav class="tm-footer__column" aria-label="Platform Links">
            <h2 class="tm-footer__heading">
                Platform
            </h2>
            <a class="tm-footer__link" href="/candidate/find-a-job">
                Find Jobs
            </a>
            <a class="tm-footer__link" href="/employer/find-a-candidate">
                Find Candidates
            </a>
            <a class="tm-footer__link" href="/candidate/companies">
                Companies
            </a>
            <a class="tm-footer__link" href="/membership">
                Membership
            </a>
        </nav>
        <nav class="tm-footer__column" aria-label="Account Links">
            <h2 class="tm-footer__heading">
                Account
            </h2>
            <a class="tm-footer__link" href="/login">
                Sign In
            </a>
            <a class="tm-footer__link" href="/register">
                Create Account
            </a>
            <a class="tm-footer__link" href="/register?type=candidate">
                Candidate Account
            </a>
            <a class="tm-footer__link" href="/register?type=employer">
                Employer Account
            </a>
        </nav>
        <section class="tm-footer__column" aria-label="Social Links">
            <h2 class="tm-footer__heading">
                Connect
            </h2>
            <div class="tm-footer__socials">
                <a class="tm-footer__social-button" href="#" aria-label="Facebook">
                    <i class="fab fa-facebook"></i>
                </a>
                <a class="tm-footer__social-button" href="#" aria-label="LinkedIn">
                    <i class="fab fa-linkedin-in"></i>
                </a>
                <a class="tm-footer__social-button" href="#" aria-label="Instagram">
                    <i class="fab fa-instagram"></i>
                </a>
                <a class="tm-footer__social-button" href="#" aria-label="Twitter">
                    <i class="fab fa-twitter"></i>
                </a>
            </div>
        </section>
    </div>
    <div class="tm-footer__bottom">
        <p class="tm-footer__meta">
            &copy; <%= new Date().getFullYear() %>
            TalentMatch. All rights reserved.
        </p>
        <div class="tm-footer__legal-links">
            <a class="tm-footer__legal-link" href="/privacy">
                Privacy
            </a>
            <a class="tm-footer__legal-link" href="/terms">
                Terms
            </a>
            <a class="tm-footer__legal-link" href="/cookies">
                Cookies
            </a>
        </div>
    </div>
</footer>