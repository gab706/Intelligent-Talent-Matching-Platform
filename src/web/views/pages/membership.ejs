<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Membership | Intelligent Talent Matching Platform</title>
    <meta name="description" content="Choose the right TalentMatch account path and learn how flexible accounts work after signup." />
    <link rel="stylesheet" href="/lib/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/lib/css/modern-normalize.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/membership.css" />
    <script src="/lib/js/jquery.min.js"></script>
</head>
<body class="<%= theme === 'DARK' ? 'dark-mode' : '' %>">
<%- include('../partials/public-header/public-header'); %>
<main class="membership-page">
    <section class="membership-page__hero" aria-labelledby="membership-title">
        <p class="membership-page__eyebrow">
            Membership
        </p>
        <h1 id="membership-title" class="membership-page__title">
            Create an account that matches what you need.
        </h1>
        <p class="membership-page__description">
            Whether you're searching for your next opportunity or your next hire,
            TalentMatch helps you get started today. Begin as a candidate or employer
            and add additional account capabilities whenever your needs grow.
        </p>
    </section>

    <section class="membership-page__path membership-page__path--candidate" aria-labelledby="candidate-account-title">
        <div class="membership-page__path-media">
            <img src="/images/home/hero-candidate.png" alt="Candidate reviewing job opportunities on a laptop" />
        </div>
        <div class="membership-page__path-copy">
            <p class="membership-page__eyebrow">
                Candidate starting path
            </p>
            <h2 id="candidate-account-title">
                Build a profile around your skills, experience, and work preferences.
            </h2>
            <p>
                Candidate accounts are for people looking for work. Your profile is
                shaped around roles, skills, availability, location, and the type of
                work you want TalentMatch to recommend.
            </p>
            <ul class="membership-page__list">
                <li>Create and maintain a candidate profile.</li>
                <li>Search jobs and companies from the candidate side.</li>
                <li>Save roles and manage applications.</li>
            </ul>
            <a class="membership-page__action" href="/candidate/register">
                Create candidate account
            </a>
        </div>
    </section>

    <section class="membership-page__path membership-page__path--employer" aria-labelledby="employer-account-title">
        <div class="membership-page__path-media">
            <img src="/images/home/hero-employer.png" alt="Employer reviewing candidate information during hiring" />
        </div>
        <div class="membership-page__path-copy">
            <p class="membership-page__eyebrow">
                Employer starting path
            </p>
            <h2 id="employer-account-title">
                Represent an organisation and manage hiring from the employer side.
            </h2>
            <p>
                Employer accounts are for companies and hiring teams. They focus on
                company details, job posts, candidate discovery, and reviewing people
                who are relevant to each role.
            </p>
            <ul class="membership-page__list">
                <li>Create a company profile.</li>
                <li>Publish and manage job postings.</li>
                <li>Review applications and discover candidate matches.</li>
            </ul>
            <a class="membership-page__action" href="/employer/register">
                Create employer account
            </a>
        </div>
    </section>

    <section class="membership-page__flex" aria-labelledby="flex-account-title">
        <div class="membership-page__flex-media">
            <img src="/images/home/hero-opportunity.png" alt="Professional reviewing opportunities and account options" />
        </div>
        <div class="membership-page__flex-copy">
            <p class="membership-page__eyebrow">
                Flexible accounts
            </p>
            <h2 id="flex-account-title">
                Flexible access is available through migration, not initial signup.
            </h2>
            <p>
                A flexible account is for users who already started as a candidate
                or employer and later need access to both workflows.
            </p>
            <ul class="membership-page__list">
                <li>Start as a candidate or employer first.</li>
                <li>Migrate when both workflows are needed.</li>
                <li>Use flexible access to move between candidate and employer tasks.</li>
            </ul>
        </div>
    </section>
</main>
<%- include('../partials/footer/footer'); %>
<script src="/js/global.js"></script>
<script src="/js/membership.js"></script>
</body>
</html>
