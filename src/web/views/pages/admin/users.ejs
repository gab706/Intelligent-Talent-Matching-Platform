<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Site Users | Intelligent Talent Matching Platform</title>
    <meta name="description" content="Review site users in TalentMatch." />
    <link rel="stylesheet" href="/lib/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/lib/css/modern-normalize.min.css" />
    <link rel="stylesheet" href="/lib/css/toastr.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/account-home.css" />
    <link rel="stylesheet" href="/css/employer-candidates.css" />
    <link rel="stylesheet" href="/css/admin-home.css" />
    <link rel="stylesheet" href="/css/admin-users.css" />
    <script src="/lib/js/jquery.min.js"></script>
    <script src="/lib/js/toastr.min.js"></script>
</head>
<body class="<%= theme === 'DARK' ? 'dark-mode' : '' %>">
<%- include('../../partials/public-header/public-header'); %>
<main class="account-home account-home--admin">
    <aside class="account-home__sidebar" aria-label="Admin navigation">
        <nav class="account-home__nav">
            <div class="account-home__nav-primary">
                <a class="account-home__nav-link" href="/admin/home">Admin Home</a>
                <a class="account-home__nav-link is-active" href="/admin/users">Site Users</a>
                <a class="account-home__nav-link" href="/admin/notification-log">Notification Log</a>
            </div>
            <div class="account-home__nav-actions">
                <a class="account-home__nav-link account-home__nav-link--mode" href="/candidate/home">Back to Public</a>
            </div>
        </nav>
    </aside>

    <section class="account-home__content admin-users employer-candidates" aria-labelledby="site-users-title">
        <div class="admin-users__header">
            <div>
                <p class="account-home__eyebrow">Admin</p>
                <h1 id="site-users-title" class="account-home__title admin-users__title">Site Users</h1>
                <p class="account-home__copy admin-users__copy">View everyone registered on the platform.</p>
            </div>
            <form class="admin-users__search" method="get" action="/admin/users">
                <label class="employer-candidates__search" for="site-user-search">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <span class="sr-only">Search site users</span>
                    <input id="site-user-search" name="search" type="search" placeholder="Search users" value="<%= searchQuery %>" autocomplete="off" />
                </label>
                <% if (searchQuery) { %>
                <a class="admin-users__clear" href="/admin/users">Clear</a>
                <% } %>
            </form>
        </div>

        <div class="employer-candidates__toolbar admin-users__toolbar">
            <p>Showing <%= showingCount %> of <%= totalUsers %></p>
        </div>

        <div class="employer-candidates__table-wrap">
            <table class="employer-candidates__table admin-users__table">
                <thead>
                <tr>
                    <th>Name</th>
                    <th>Role</th>
                    <th>Member</th>
                    <th>Active</th>
                </tr>
                </thead>
                <tbody>
                <% users.forEach(user => { %>
                <tr data-user-row="<%= user.id %>">
                    <td>
                        <button class="admin-users__name-link" type="button" data-user-open="<%= user.id %>"><%= user.name %></button>
                    </td>
                    <td>
                        <span class="admin-users__role" data-tooltip="<%= user.role === 'ADMIN' ? 'Admin' : 'User' %>" aria-label="<%= user.role === 'ADMIN' ? 'Admin' : 'User' %>">
                            <i class="fas <%= user.role === 'ADMIN' ? 'fa-crown' : 'fa-user' %>" aria-hidden="true"></i>
                        </span>
                    </td>
                    <td class="admin-users__member">
                        <input type="checkbox" disabled <%= user.isMember ? 'checked' : '' %> aria-label="<%= user.isMember ? 'Member' : 'Not a member' %>" />
                    </td>
                    <td>
                        <span class="<%= user.isActiveNow ? 'admin-users__active-now' : user.isOffline ? 'admin-users__offline' : '' %>"><%= user.lastActiveLabel %></span>
                    </td>
                </tr>
                <% }) %>
                </tbody>
            </table>
        </div>
        <% if (!users.length) { %>
        <p class="employer-candidates__empty admin-users__empty">No users match that search.</p>
        <% } %>
        <% if (totalUsers > 0) { %>
        <nav class="employer-candidates__pagination" aria-label="Site user pages">
            <% for (let page = 1; page <= pageCount; page += 1) { %>
            <a class="employer-candidates__page <%= page === currentPage ? 'is-active' : '' %>" href="/admin/users?page=<%= page %><%= searchQuery ? `&search=${encodeURIComponent(searchQuery)}` : '' %>"><%= page %></a>
            <% } %>
        </nav>
        <% } %>
    </section>
</main>

<div class="admin-users__modal" hidden data-user-modal>
    <div class="admin-users__modal-overlay" data-user-modal-close></div>
    <section class="admin-users__dialog admin-users__dialog--user" role="dialog" aria-modal="true" aria-labelledby="user-modal-title">
        <button class="admin-users__modal-close" type="button" aria-label="Close user details" data-user-modal-close>
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <div class="admin-users__modal-heading">
            <img src="/images/avatar/default.png" alt="" data-user-avatar />
            <div>
                <h2 id="user-modal-title" data-user-title>User details</h2>
                <p data-user-subtitle></p>
            </div>
        </div>
        <div class="admin-users__suspension-banner" hidden data-user-suspension-banner></div>
        <div class="admin-users__details" data-user-details></div>
        <div class="admin-users__modal-actions admin-users__modal-actions--main">
            <button type="button" data-user-suspend-action></button>
            <button type="button" data-user-impersonate>Impersonate</button>
        </div>
    </section>
</div>

<div class="admin-users__modal admin-users__modal--suspend" hidden data-suspend-modal>
    <div class="admin-users__modal-overlay" data-suspend-modal-close></div>
    <section class="admin-users__dialog admin-users__dialog--suspend" role="dialog" aria-modal="true" aria-labelledby="suspend-modal-title">
        <button class="admin-users__modal-close" type="button" aria-label="Close suspension form" data-suspend-modal-close>
            <i class="fas fa-times" aria-hidden="true"></i>
        </button>
        <div class="admin-users__suspend-heading">
            <p class="account-home__eyebrow">Suspend user</p>
            <h2 id="suspend-modal-title">Suspend User</h2>
            <p data-suspend-user-name></p>
        </div>
        <form class="admin-users__suspend-form" data-suspend-form>
            <label class="admin-users__field" for="suspend-reason">
                <span>Reason</span>
                <textarea id="suspend-reason" name="reason" rows="4"></textarea>
            </label>
            <label class="admin-users__field" for="suspend-duration">
                <span>Duration</span>
                <span class="admin-users__select-wrap">
                    <select id="suspend-duration" name="duration">
                        <option value="1h">1 hour</option>
                        <option value="6h">6 hours</option>
                        <option value="12h">12 hours</option>
                        <option value="24h">24 hours</option>
                        <option value="7d">7 days</option>
                        <option value="30d">30 days</option>
                        <option value="permanent">Permanent</option>
                    </select>
                    <i class="fas fa-chevron-down" aria-hidden="true"></i>
                </span>
            </label>
            <div class="admin-users__modal-actions">
                <button type="submit" data-suspend-submit>Confirm suspension</button>
            </div>
        </form>
    </section>
</div>

<script>
    window.__adminUsers = <%- usersJson %>;
</script>
<script src="/js/global.js"></script>
<script src="/js/admin-users.js"></script>
</body>
</html>
