<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>Employer Home | Intelligent Talent Matching Platform</title>
    <meta name="description" content="Employer home for TalentMatch." />
    <link rel="stylesheet" href="/lib/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/lib/css/modern-normalize.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/account-home.css" />
    <link rel="stylesheet" href="/css/employer-home.css" />
    <script src="/lib/js/jquery.min.js"></script>
</head>
<body class="<%= theme === 'DARK' ? 'dark-mode' : '' %>">
<%
    const home = typeof employerHome !== 'undefined' ? employerHome : {
        candidateCount: 0,
        companies: [],
        activePostings: [],
        draftPostings: [],
        closedPostings: [],
        recentPostings: [],
        closingSoon: [],
        pendingInvitations: [],
        stats: {
            companyCount: 0,
            activePostingCount: 0,
            draftPostingCount: 0,
            closedPostingCount: 0,
            totalApplications: 0,
            pendingInvitationCount: 0
        }
    };
%>
<%- include('../../partials/public-header/public-header'); %>
<main class="account-home account-home--employer">
    <aside class="account-home__sidebar" aria-label="Employer navigation">
        <nav class="account-home__nav">
            <div class="account-home__nav-primary">
                <a class="account-home__nav-link is-active" href="/employer/home">Employer Home</a>
                <a class="account-home__nav-link" href="/employer/find-a-candidate">Find a Candidate</a>
                <a class="account-home__nav-link" href="/employer/postings">Tracking Postings</a>
                <a class="account-home__nav-link" href="/employer/applications">Manage Applications</a>
                <a class="account-home__nav-link" href="/employer/companies">Manage Companies</a>
            </div>
            <div class="account-home__nav-actions">
                <% if (accountType === 3) { %>
                <a class="account-home__nav-link account-home__nav-link--mode" href="/candidate/home">Swap to Candidate Mode</a>
                <% } else { %>
                <a class="account-home__nav-link account-home__nav-link--mode" href="/employer/migrate">Migrate to Candidate Account</a>
                <% } %>
                <% if (isAdmin) { %>
                <a class="account-home__nav-link account-home__nav-link--admin" href="/admin/home">Admin Control</a>
                <% } %>
            </div>
        </nav>
    </aside>

    <section class="account-home__content employer-home" aria-labelledby="employer-home-title">
        <div class="employer-home__hero">
            <div>
                <p class="account-home__eyebrow">Employer home</p>
                <h1 id="employer-home-title" class="account-home__title employer-home__title">
                    Welcome back <%= firstName || 'there' %>
                </h1>
                <p class="account-home__copy employer-home__intro">
                    Keep the essentials close: your companies, open roles, and the next move in the hiring flow.
                </p>
                <p class="employer-home__pulse">
                    <% if (home.stats.activePostingCount) { %>
                    <strong><%= home.stats.activePostingCount %> active role<%= home.stats.activePostingCount === 1 ? '' : 's' %></strong>
                    <span><%= home.stats.totalApplications %> application<%= home.stats.totalApplications === 1 ? '' : 's' %> across your workspace.</span>
                    <% } else if (home.stats.companyCount) { %>
                    <strong>Ready for a role</strong>
                    <span>Your company setup is in place.</span>
                    <% } else { %>
                    <strong>Company needed</strong>
                    <span>Create or join an organisation before posting roles.</span>
                    <% } %>
                </p>
            </div>
            <div class="employer-home__hero-actions" aria-label="Employer quick actions">
                <a class="employer-home__primary-link" href="/employer/postings">
                    <i class="fas fa-plus" aria-hidden="true"></i>
                    Create posting
                </a>
                <a class="employer-home__secondary-link" href="/employer/companies">
                    <i class="fas fa-building" aria-hidden="true"></i>
                    Manage companies
                </a>
            </div>
        </div>

        <section class="employer-home__stats" aria-label="Hiring snapshot">
            <article class="employer-home__stat">
                <span>Companies</span>
                <strong><%= home.stats.companyCount %></strong>
            </article>
            <article class="employer-home__stat">
                <span>Active postings</span>
                <strong><%= home.stats.activePostingCount %></strong>
            </article>
            <article class="employer-home__stat">
                <span>Candidate pool</span>
                <strong><%= home.candidateCount %></strong>
            </article>
        </section>

        <section class="employer-home__panel" aria-labelledby="postings-title">
            <div class="employer-home__section-head">
                <div>
                    <p class="account-home__eyebrow">Postings</p>
                    <h2 id="postings-title">Recent activity</h2>
                </div>
                <a href="/employer/postings">View all</a>
            </div>
            <% if (home.recentPostings.length) { %>
            <div class="employer-home__posting-list">
                <% home.recentPostings.slice(0, 3).forEach((posting) => { %>
                <article class="employer-home__posting">
                    <div>
                        <strong><%= posting.jobTitle %></strong>
                        <p><%= posting.companyName %> | <%= posting.jobLocation %></p>
                    </div>
                    <div class="employer-home__posting-meta">
                        <span class="employer-home__status employer-home__status--<%= posting.status.toLowerCase() %>"><%= posting.status %></span>
                        <small><%= posting.applicationCount %> application<%= posting.applicationCount === 1 ? '' : 's' %></small>
                    </div>
                </article>
                <% }) %>
            </div>
            <% } else { %>
            <div class="employer-home__empty">
                <h3>No postings yet</h3>
                <p>Create a posting once your company profile is ready.</p>
            </div>
            <% } %>
        </section>
    </section>
</main>
<script src="/js/global.js"></script>
</body>
</html>
