<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Companies | Intelligent Talent Matching Platform</title>
    <meta name="description" content="Explore companies using TalentMatch." />
    <link rel="stylesheet" href="/lib/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/lib/css/modern-normalize.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/companies.css" />
    <script src="/lib/js/jquery.min.js"></script>
</head>
<body class="<%= theme === 'DARK' ? 'dark-mode' : '' %>">
<%- include('../partials/public-header/public-header'); %>
<main class="companies-page">
    <section class="companies-page__hero" aria-labelledby="companies-title">
        <h1 id="companies-title" class="companies-page__title">
            Company directory
        </h1>
        <% if (companies && companies.length) { %>
        <label class="companies-page__search" for="company-directory-search">
            <i class="fas fa-search" aria-hidden="true"></i>
            <span class="sr-only">Search companies</span>
            <input id="company-directory-search" type="search" placeholder="Search companies by name, industry, or location" autocomplete="off" data-company-search />
            <button class="companies-page__search-clear" type="button" aria-label="Clear search" data-company-search-clear hidden>
                <i class="fas fa-times" aria-hidden="true"></i>
            </button>
        </label>
        <% } %>
    </section>

    <section class="companies-page__directory" aria-labelledby="companies-directory-title">
        <div class="companies-page__directory-header">
            <div>
                <% if (companies && companies.length) { %>
                <p data-company-count data-company-total="<%= companies.length %>">
                    Showing <%= companies.length %> of <%= companies.length %>
                </p>
                <% } %>
            </div>
        </div>

        <% if (companies && companies.length) { %>
        <ul class="companies-page__list" data-company-list>
            <% companies.forEach((company) => { %>
            <li class="companies-page__item" data-company-item data-company-search-text="<%= [company.name, company.industry, company.location, company.description].filter(Boolean).join(' ').toLowerCase() %>">
                <a class="companies-page__company" href="/companies/<%= encodeURIComponent(company.name) %>">
                    <span class="companies-page__logo-wrap">
                        <% if (company.logoUrl) { %>
                        <img class="companies-page__logo" src="<%= company.logoUrl %>" alt="<%= company.name %> logo" />
                        <% } else { %>
                        <span class="companies-page__logo-placeholder" aria-hidden="true">
                            <i class="fas fa-building" aria-hidden="true"></i>
                        </span>
                        <% } %>
                    </span>
                    <span class="companies-page__copy">
                        <strong><%= company.name %></strong>
                        <% if (company.industry || company.location) { %>
                        <span class="companies-page__meta">
                            <%= [company.industry, company.location].filter(Boolean).join(' | ') %>
                        </span>
                        <% } %>
                        <% if (company.description) { %>
                        <span class="companies-page__summary">
                            <%= company.description %>
                        </span>
                        <% } %>
                    </span>
                    <span class="companies-page__visit">
                        View profile
                    </span>
                </a>
            </li>
            <% }); %>
        </ul>
        <p class="companies-page__empty companies-page__empty--filtered" hidden data-company-filter-empty>
            No companies match that search.
        </p>
        <nav class="companies-page__pagination" aria-label="Company directory pages" data-company-pagination></nav>
        <% } else { %>
        <p class="companies-page__empty">
            Well this is awkward but there is nothing here...
        </p>
        <% } %>
    </section>
</main>
<%- include('../partials/footer/footer'); %>
<script src="/js/global.js"></script>
<script src="/js/companies.js"></script>
</body>
</html>
