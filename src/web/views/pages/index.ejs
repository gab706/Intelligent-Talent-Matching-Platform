<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home | Intelligent Talent Matching Platform</title>
    <meta name="description" content="TalentMatch helps candidates find jobs and employers find candidates using intelligent profile and job matching." />
    <link rel="stylesheet" href="/lib/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/lib/css/modern-normalize.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/index.css" />
    <script src="/lib/js/jquery.min.js"></script>
</head>
<body class="<%= theme === 'DARK' ? 'dark-mode' : '' %>">
<%- include('../partials/public-header/public-header'); %>
<main class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
        <div class="home-hero__slides" aria-hidden="true" data-home-slider>
            <img class="home-hero__slide is-active" src="/images/home/hero-candidate.png" alt="" />
            <img class="home-hero__slide" src="/images/home/hero-opportunity.png" alt="" />
            <img class="home-hero__slide" src="/images/home/hero-employer.png" alt="" />
        </div>
        <div class="home-hero__content">
            <p class="home-hero__eyebrow">
                Intelligent Talent Matching Platform
            </p>
            <h1 id="home-hero-title" class="home-hero__title">
                Your next match starts here.
            </h1>
            <p class="home-hero__description">
                Connect with relevant roles and candidates through profile-based
                recommendations shaped by skills, experience, location, and work
                preferences.
            </p>
            <form
                    class="home-search"
                    action="/candidate/find-a-job"
                    method="get"
                    role="search"
                    data-progressive-search
                    data-authenticated="<%= isAuthenticated ? 'true' : 'false' %>"
                    data-account-type="<%= accountType || '' %>"
            >
                <div class="home-search__field home-search__field--keywords">
                    <label for="home-search-keywords" class="home-search__label">
                        What are you looking for?
                    </label>
                    <div class="home-search__input-row">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input
                                id="home-search-keywords"
                                name="q"
                                type="search"
                                autocomplete="off"
                                placeholder="Software engineer, data analyst, UX designer"
                        />
                    </div>
                </div>
                <div class="home-search__field home-search__field--location">
                    <label for="home-search-location" class="home-search__label">
                        Where?
                    </label>
                    <div class="home-search__input-row">
                        <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                        <input
                                id="home-search-location"
                                name="location"
                                type="search"
                                autocomplete="off"
                                placeholder="Sydney, remote, hybrid"
                        />
                    </div>
                </div>
                <button class="home-search__submit" type="submit">
                    Search
                </button>
            </form>
            <div class="home-hero__indicators" aria-label="Hero image slides">
                <button class="home-hero__indicator is-active" type="button" aria-label="Show candidate slide" data-slide-index="0"></button>
                <button class="home-hero__indicator" type="button" aria-label="Show opportunity slide" data-slide-index="1"></button>
                <button class="home-hero__indicator" type="button" aria-label="Show employer slide" data-slide-index="2"></button>
            </div>
        </div>
    </section>
</main>
<%- include('../partials/footer/footer'); %>
<script src="/js/global.js"></script>
<script src="/js/index.js"></script>
</body>
</html>
