<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home | Intelligent Talent Matching Platform</title>
    <meta name="description" content="TalentMatch helps candidates find jobs and employers find candidates using intelligent profile and job matching." />
    <link rel="stylesheet" href="/lib/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/lib/css/modern-normalize.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/home.css" />
    <script src="/lib/js/jquery.min.js"></script>
</head>
<body class="<%= theme === 'DARK' ? 'dark-mode' : '' %>">
<%- include('../partials/public-header/public-header'); %>
<main class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
        <form class="home-search" action="/candidate/search" method="get" role="search" data-progressive-search>
            <div class="home-search__field home-search__field--keywords">
                <div class="home-search__field-inner">
                    <label for="home-search-keywords" class="home-search__label">
                        Job title, skills, keyword, or company
                    </label>
                    <div class="home-search__input-row">
                        <i class="fas fa-search" aria-hidden="true"></i>
                        <input id="home-search-keywords" name="q" type="search" autocomplete="off" />
                    </div>
                </div>
            </div>
            <div class="home-search__field home-search__field--location" data-location-field>
                <div class="home-search__field-inner">
                    <label for="home-search-location" class="home-search__label">
                        Location
                    </label>
                    <div class="home-search__input-row">
                        <i class="fas fa-map-marker-alt" aria-hidden="true"></i>
                        <input id="home-search-location" name="location" type="search" autocomplete="off" />
                    </div>
                </div>
            </div>
            <button class="home-search__submit" type="submit" data-search-submit>
                Find jobs
            </button>
        </form>
        <div class="home-hero__content">
            <p class="home-hero__eyebrow">
                Intelligent Talent Matching Platform
            </p>
            <h1 id="home-hero-title" class="home-hero__title">
                Your next match starts here.
            </h1>
            <p class="home-hero__description">
                Create a profile to receive smarter job and candidate
                recommendations based on skills, experience,
                working preferences, and intelligent matching logic.
            </p>
            <div class="home-hero__actions">
                <a href="/register" class="home-hero__cta">
                    Get started
                    <i class="fas fa-arrow-right" aria-hidden="true"></i>
                </a>
            </div>
            <div class="home-hero__secondary-actions">
                <a href="/candidate/find-a-job">Browse jobs</a>
                <span aria-hidden="true">·</span>
                <a href="/employer/find-a-candidate">Browse candidates</a>
                <span aria-hidden="true">·</span>
                <a href="/login">Login</a>
            </div>
        </div>
    </section>
    <section class="home-quick-links" aria-label="Quick platform actions">
        <a href="/register?type=candidate" class="home-quick-link-card">
            <i class="fas fa-user-tie" aria-hidden="true"></i>
            <div class="home-quick-link-card__content">
                <strong>Candidate profiles</strong>
                <span>Build your profile and receive recommendations</span>
            </div>
        </a>
        <a href="/register?type=employer" class="home-quick-link-card">
            <i class="fas fa-building" aria-hidden="true"></i>
            <div class="home-quick-link-card__content">
                <strong>Employer accounts</strong>
                <span>Post jobs and discover suitable candidates</span>
            </div>
        </a>
        <a href="/membership" class="home-quick-link-card">
            <i class="fas fa-star" aria-hidden="true"></i>
            <div class="home-quick-link-card__content">
                <strong>Membership access</strong>
                <span>Unlock unlimited intelligent recommendations</span>
            </div>
        </a>
    </section>
</main>
<%- include('../partials/footer/footer'); %>
<script src="/js/global.js"></script>
<script src="/js/home.js"></script>
</body>
</html>