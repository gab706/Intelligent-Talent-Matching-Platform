<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Candidate Home | Intelligent Talent Matching Platform</title>
    <meta name="description" content="Candidate home for TalentMatch." />
    <link rel="stylesheet" href="/lib/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/lib/css/modern-normalize.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/account-home.css" />
    <link rel="stylesheet" href="/css/candidate-home.css" />
    <script src="/lib/js/jquery.min.js"></script>
</head>
<body class="<%= theme === 'DARK' ? 'dark-mode' : '' %>">
<%
    const home = typeof candidateHome !== 'undefined' ? candidateHome : {
        savedJobCount: 0,
        recommendedJobCount: 0,
        profileCompletion: 0,
        profileTasks: [],
        statusCounts: {},
        recentApplications: []
    };
%>
<%- include('../../partials/public-header/public-header'); %>
<main class="account-home account-home--candidate">
    <aside class="account-home__sidebar" aria-label="Candidate navigation">
        <nav class="account-home__nav">
            <div class="account-home__nav-primary">
                <a class="account-home__nav-link is-active" href="/candidate/home">Candidate Home</a>
                <a class="account-home__nav-link" href="/candidate/find-a-job">Find a Job</a>
                <a class="account-home__nav-link" href="/candidate/applications">Track Applications</a>
                <a class="account-home__nav-link" href="/candidate/profile">Manage Profile</a>
            </div>
            <div class="account-home__nav-actions">
                <% if (accountType === 3) { %>
                <a class="account-home__nav-link account-home__nav-link--mode" href="/employer/home">Swap to Employer Mode</a>
                <% } else { %>
                <a class="account-home__nav-link account-home__nav-link--mode" href="/candidate/migrate">Migrate to Employer Account</a>
                <% } %>
                <% if (isAdmin) { %>
                <a class="account-home__nav-link account-home__nav-link--admin" href="/admin/home">Admin Control</a>
                <% } %>
            </div>
        </nav>
    </aside>

    <section class="account-home__content candidate-home" aria-labelledby="candidate-home-title">
        <div class="candidate-home__hero">
            <div>
                <p class="account-home__eyebrow">Candidate home</p>
                <h1 id="candidate-home-title" class="account-home__title candidate-home__title">
                    Welcome back <%= firstName || 'there' %>
                </h1>
                <p class="account-home__copy candidate-home__intro">
                    Track applications, keep your profile sharp, and jump back into job discovery.
                </p>
                <p class="candidate-home__pulse">
                    <strong><%= home.profileCompletion %>% profile ready</strong>
                    <span><%= home.recommendedJobCount %> recommendation<%= home.recommendedJobCount === 1 ? '' : 's' %> currently available.</span>
                </p>
            </div>
            <div class="candidate-home__hero-actions" aria-label="Candidate quick actions">
                <a class="candidate-home__primary-link" href="/candidate/find-a-job">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    Find jobs
                </a>
                <a class="candidate-home__secondary-link" href="/candidate/profile">
                    <i class="fas fa-user-edit" aria-hidden="true"></i>
                    Manage profile
                </a>
            </div>
        </div>

        <section class="candidate-home__stats" aria-label="Candidate snapshot">
            <article class="candidate-home__stat">
                <span>Applications</span>
                <strong><%= (home.statusCounts.APPLIED || 0) + (home.statusCounts.SHORTLISTED || 0) + (home.statusCounts.HIRED || 0) + (home.statusCounts.REJECTED || 0) %></strong>
            </article>
            <article class="candidate-home__stat">
                <span>Shortlisted</span>
                <strong><%= home.statusCounts.SHORTLISTED || 0 %></strong>
            </article>
            <article class="candidate-home__stat">
                <span>Saved jobs</span>
                <strong><%= home.savedJobCount %></strong>
            </article>
        </section>

        <section class="candidate-home__panel" aria-labelledby="candidate-activity-title">
            <div class="candidate-home__section-head">
                <div>
                    <p class="account-home__eyebrow">Applications</p>
                    <h2 id="candidate-activity-title">Recent activity</h2>
                </div>
                <a href="/candidate/applications">View all</a>
            </div>
            <% if (home.recentApplications.length) { %>
            <div class="candidate-home__application-list">
                <% home.recentApplications.forEach((application) => { %>
                <article class="candidate-home__application">
                    <div>
                        <strong><%= application.jobTitle %></strong>
                        <p><%= application.companyName %> | <%= application.jobLocation %></p>
                    </div>
                    <div class="candidate-home__application-meta">
                        <span class="candidate-home__status candidate-home__status--<%= application.status.toLowerCase() %>"><%= application.statusLabel %></span>
                        <small data-local-date="<%= application.updatedAt %>"><%= application.updatedAt %></small>
                    </div>
                </article>
                <% }) %>
            </div>
            <% } else { %>
            <div class="candidate-home__empty">
                <h3>No applications yet</h3>
                <p>Once you apply for roles, the latest movement will appear here.</p>
            </div>
            <% } %>
        </section>
    </section>
</main>
<script src="/js/global.js"></script>
</body>
</html>
