<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Candidate Home | Intelligent Talent Matching Platform</title>
    <meta name="description" content="Candidate home for TalentMatch." />
    <link rel="stylesheet" href="/lib/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/lib/css/modern-normalize.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/register.css" />
    <script src="/lib/js/jquery.min.js"></script>
</head>
<body class="<%= theme === 'DARK' ? 'dark-mode' : '' %>">
<%- include('../../partials/public-header/public-header'); %>
<main class="register-candidate">
    <section class="register-candidate__shell" aria-labelledby="candidate-home-title">
        <div class="register-candidate__intro">
            <p class="register-candidate__eyebrow">
                Candidate home
            </p>
            <h1 id="candidate-home-title">
