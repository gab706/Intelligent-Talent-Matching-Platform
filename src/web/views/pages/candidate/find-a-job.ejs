<!DOCTYPE html>
<html lang="en-AU">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Find Jobs | Intelligent Talent Matching Platform</title>
    <meta name="description" content="Search and discover recommended jobs in TalentMatch." />
    <link rel="stylesheet" href="/lib/css/font-awesome.min.css" />
    <link rel="stylesheet" href="/lib/css/modern-normalize.min.css" />
    <link rel="stylesheet" href="/lib/css/toastr.min.css" />
    <link rel="stylesheet" href="/css/global.css" />
    <link rel="stylesheet" href="/css/account-home.css" />
    <link rel="stylesheet" href="/css/find-a-job.css" />
    <script src="/lib/js/jquery.min.js"></script>
    <script src="/lib/js/toastr.min.js"></script>
</head>
<body class="<%= theme === 'DARK' ? 'dark-mode' : '' %>">
<%
    const filterLabels = {
        workMode: { REMOTE: 'Remote', ONSITE: 'On-site', HYBRID: 'Hybrid' },
        jobType: { FULL_TIME: 'Full Time', PART_TIME: 'Part Time', CASUAL: 'Casual', CONTRACT: 'Contract', INTERNSHIP: 'Internship' },
        educationLevel: {
            CERTIFICATE_I: 'Certificate I',
            CERTIFICATE_II: 'Certificate II',
            CERTIFICATE_III: 'Certificate III',
            CERTIFICATE_IV: 'Certificate IV',
            DIPLOMA: 'Diploma',
            ADVANCED_DIPLOMA: 'Advanced Diploma',
            ASSOCIATE_DEGREE: 'Associate Degree',
            BACHELORS_DEGREE: "Bachelor's Degree",
            GRADUATE_CERTIFICATE: 'Graduate Certificate',
            GRADUATE_DIPLOMA: 'Graduate Diploma',
            MASTERS_DEGREE: "Master's Degree",
            DOCTORAL_DEGREE: 'Doctoral Degree'
        }
    };
    const filterQueryEntries = [];
    if (filters.keyword) filterQueryEntries.push(['keyword', filters.keyword]);
    if (filters.location) filterQueryEntries.push(['location', filters.location]);
    if (filters.workMode) filterQueryEntries.push(['workMode', filters.workMode]);
    if (filters.jobType) filterQueryEntries.push(['jobType', filters.jobType]);
    if (filters.requiredExperience) filterQueryEntries.push(['requiredExperience', filters.requiredExperience]);
    if (filters.educationLevel) filterQueryEntries.push(['educationLevel', filters.educationLevel]);
    if (filters.salaryMin) filterQueryEntries.push(['salaryMin', filters.salaryMin]);
    if (filters.salaryMax) filterQueryEntries.push(['salaryMax', filters.salaryMax]);
    (filters.skills || []).forEach(skill => filterQueryEntries.push(['skill', skill]));
    const removeFilterHref = function (removeKey) {
        const params = new URLSearchParams();
        filterQueryEntries.forEach(([key, value]) => {
            if (key !== removeKey)
                params.append(key, value);
        });
        const query = params.toString();
        return query ? `/candidate/find-a-job?${query}` : '/candidate/find-a-job';
    };
    const activeFilters = [
        filters.location ? { key: 'location', label: `Location: ${filters.location}` } : null,
        filters.workMode ? { key: 'workMode', label: `Work mode: ${filterLabels.workMode[filters.workMode] || filters.workMode}` } : null,
        filters.jobType ? { key: 'jobType', label: `Job type: ${filterLabels.jobType[filters.jobType] || filters.jobType}` } : null,
        filters.requiredExperience ? { key: 'requiredExperience', label: `Experience: ${filters.requiredExperience}+ years` } : null,
        filters.educationLevel ? { key: 'educationLevel', label: `Education: ${filterLabels.educationLevel[filters.educationLevel] || filters.educationLevel}` } : null,
        filters.salaryMin ? { key: 'salaryMin', label: `Salary min: ${Number.isFinite(Number(filters.salaryMin)) ? `$${Number(filters.salaryMin).toLocaleString('en-AU')}` : filters.salaryMin}` } : null,
        filters.salaryMax ? { key: 'salaryMax', label: `Salary max: ${Number.isFinite(Number(filters.salaryMax)) ? `$${Number(filters.salaryMax).toLocaleString('en-AU')}` : filters.salaryMax}` } : null,
        (filters.skills || []).length ? { key: 'skill', label: `Skills: ${(filters.skills || []).join(', ')}` } : null
    ].filter(Boolean);
%>
<%- include('../../partials/public-header/public-header'); %>
<main class="account-home account-home--candidate">
    <aside class="account-home__sidebar" aria-label="Candidate navigation">
        <nav class="account-home__nav">
            <div class="account-home__nav-primary">
                <a class="account-home__nav-link" href="/candidate/home">Candidate Home</a>
                <a class="account-home__nav-link is-active" href="/candidate/find-a-job">Find a Job</a>
                <a class="account-home__nav-link" href="/candidate/applications">Track Applications</a>
                <a class="account-home__nav-link" href="/candidate/profile">Manage Profile</a>
            </div>
            <div class="account-home__nav-actions">
                <% if (accountType === 3) { %>
                <a class="account-home__nav-link account-home__nav-link--mode" href="/employer/home">Swap to Employer Mode</a>
                <% } else { %>
                <a class="account-home__nav-link account-home__nav-link--mode" href="/candidate/migrate">Migrate to Employer Account</a>
                <% } %>
                <% if (isAdmin) { %>
                <a class="account-home__nav-link account-home__nav-link--admin" href="/admin/control">Admin Control</a>
                <% } %>
            </div>
        </nav>
    </aside>

    <section class="account-home__content find-job-page" aria-labelledby="find-job-title">
        <div class="find-job-page__hero">
            <p class="account-home__eyebrow">Find Jobs</p>
            <h1 id="find-job-title" class="account-home__title find-job-page__title">
                Find what works for you.
            </h1>
            <p class="account-home__copy find-job-page__intro">
                Search active postings, filter by role details, and compare those results with TalentMatch recommendations.
            </p>
        </div>

        <div class="find-job-page__tabs" aria-label="Job views">
            <button class="is-active" type="button" data-job-tab="search">Search Jobs</button>
            <button type="button" data-job-tab="recommended">Recommended Jobs</button>
        </div>

        <section class="find-job-page__results" aria-labelledby="job-results-title" data-job-panel="search">
            <form id="find-job-search-form" class="find-job-page__search" method="get" action="/candidate/find-a-job" data-find-job-form>
                <label class="find-job-page__keyword">
                    <i class="fas fa-search" aria-hidden="true"></i>
                    <span class="sr-only">Keyword</span>
                    <input type="search" name="keyword" value="<%= filters.keyword %>" placeholder="Search title, company, location, description, or skills" autocomplete="off" />
                </label>
                <div class="find-job-page__search-actions">
                    <% if (activeFilters.length) { %>
                    <a class="find-job-page__clear-filters" href="/candidate/find-a-job">Clear filters</a>
                    <% } %>
                    <button class="find-job-page__filter-button" type="button" data-job-filter-open>
                        <i class="fas fa-filter" aria-hidden="true"></i>
                        Filter
                        <% if (activeFilters.length) { %>
                        <span><%= activeFilters.length %></span>
                        <% } %>
                    </button>
                </div>
            </form>

            <% if (activeFilters.length) { %>
            <div class="find-job-page__active-filters" aria-label="Active filters">
                <% activeFilters.forEach((filter) => { %>
                <a href="<%= removeFilterHref(filter.key) %>">
                    <span><%= filter.label %></span>
                    <i class="fas fa-times" aria-hidden="true"></i>
                </a>
                <% }) %>
            </div>
            <% } %>

            <div class="find-job-page__section-head">
                <div>
                    <p class="account-home__eyebrow">Search results</p>
                    <h2 id="job-results-title">Job Results</h2>
                </div>
                <span data-search-result-count><%= jobs.length %> active match<%= jobs.length === 1 ? '' : 'es' %></span>
            </div>
            <% if (jobs.length) { %>
            <div class="find-job-page__job-list" data-search-results-list>
                <% jobs.forEach((job) => { %>
                <%- include('../../partials/candidate-job-card', { job, savedJobIds, appliedJobIds, appliedJobs, showScore: false }) %>
                <% }) %>
            </div>
            <% } else { %>
            <div class="find-job-page__empty" data-search-empty>
                <h3>No jobs found</h3>
                <p>Try widening the keyword or removing one of the filters.</p>
            </div>
            <% } %>
            <% if (jobs.length) { %>
            <div class="find-job-page__empty" data-search-empty hidden>
                <h3>No jobs found</h3>
                <p>Try widening the keyword or removing one of the filters.</p>
            </div>
            <% } else { %>
            <div class="find-job-page__job-list" data-search-results-list></div>
            <% } %>
        </section>

        <section class="find-job-page__recommendations" aria-labelledby="recommended-jobs-title" data-job-panel="recommended" hidden>
            <div class="find-job-page__section-head">
                <div>
                    <p class="account-home__eyebrow">Recommended for You</p>
                    <h2 id="recommended-jobs-title">Recommended jobs</h2>
                </div>
                <span><%= isMember ? 'Unlimited recommendations enabled' : 'Showing Top 10 recommendations' %></span>
            </div>
            <% if (recommendedJobs.length) { %>
            <div class="find-job-page__job-list">
                <% recommendedJobs.forEach((job) => { %>
                <%- include('../../partials/candidate-job-card', { job, savedJobIds, appliedJobIds, appliedJobs, showScore: true }) %>
                <% }) %>
            </div>
            <% } else { %>
            <div class="find-job-page__empty">
                <h3>No recommendations available</h3>
                <p>Complete more of your candidate profile to help TalentMatch find stronger matches.</p>
            </div>
            <% } %>
        </section>

        <div class="find-job-page__modal" hidden aria-hidden="true" data-job-filter-modal>
            <div class="find-job-page__overlay" data-job-filter-close></div>
            <section class="find-job-page__dialog find-job-page__dialog--filters" role="dialog" aria-modal="true" aria-labelledby="job-filter-title">
                <button class="find-job-page__close" type="button" aria-label="Close filters" data-job-filter-close>
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
                <div>
                    <h2 id="job-filter-title">Filter jobs</h2>
                    <p class="find-job-page__dialog-note">Choose the role details you want results to match.</p>
                </div>
                <section class="find-job-page__filters" aria-label="Job filters">
                    <label>
                        <span>Location</span>
                        <input form="find-job-search-form" type="text" name="location" value="<%= filters.location %>" placeholder="Sydney" />
                    </label>
                    <label>
                        <span>Work mode</span>
                        <select form="find-job-search-form" name="workMode">
                            <option value="">Any mode</option>
                            <option value="REMOTE" <%= filters.workMode === 'REMOTE' ? 'selected' : '' %>>Remote</option>
                            <option value="ONSITE" <%= filters.workMode === 'ONSITE' ? 'selected' : '' %>>On-site</option>
                            <option value="HYBRID" <%= filters.workMode === 'HYBRID' ? 'selected' : '' %>>Hybrid</option>
                        </select>
                    </label>
                    <label>
                        <span>Job type</span>
                        <select form="find-job-search-form" name="jobType">
                            <option value="">Any type</option>
                            <option value="FULL_TIME" <%= filters.jobType === 'FULL_TIME' ? 'selected' : '' %>>Full Time</option>
                            <option value="PART_TIME" <%= filters.jobType === 'PART_TIME' ? 'selected' : '' %>>Part Time</option>
                            <option value="CASUAL" <%= filters.jobType === 'CASUAL' ? 'selected' : '' %>>Casual</option>
                            <option value="CONTRACT" <%= filters.jobType === 'CONTRACT' ? 'selected' : '' %>>Contract</option>
                            <option value="INTERNSHIP" <%= filters.jobType === 'INTERNSHIP' ? 'selected' : '' %>>Internship</option>
                        </select>
                    </label>
                    <label>
                        <span>Experience</span>
                        <input form="find-job-search-form" type="number" min="0" name="requiredExperience" value="<%= filters.requiredExperience %>" placeholder="Years you can meet" />
                    </label>
                    <label>
                        <span>Education</span>
                        <select form="find-job-search-form" name="educationLevel">
                            <option value="">Any level</option>
                            <option value="CERTIFICATE_I" <%= filters.educationLevel === 'CERTIFICATE_I' ? 'selected' : '' %>>Certificate I</option>
                            <option value="CERTIFICATE_II" <%= filters.educationLevel === 'CERTIFICATE_II' ? 'selected' : '' %>>Certificate II</option>
                            <option value="CERTIFICATE_III" <%= filters.educationLevel === 'CERTIFICATE_III' ? 'selected' : '' %>>Certificate III</option>
                            <option value="CERTIFICATE_IV" <%= filters.educationLevel === 'CERTIFICATE_IV' ? 'selected' : '' %>>Certificate IV</option>
                            <option value="DIPLOMA" <%= filters.educationLevel === 'DIPLOMA' ? 'selected' : '' %>>Diploma</option>
                            <option value="ADVANCED_DIPLOMA" <%= filters.educationLevel === 'ADVANCED_DIPLOMA' ? 'selected' : '' %>>Advanced Diploma</option>
                            <option value="ASSOCIATE_DEGREE" <%= filters.educationLevel === 'ASSOCIATE_DEGREE' ? 'selected' : '' %>>Associate Degree</option>
                            <option value="BACHELORS_DEGREE" <%= filters.educationLevel === 'BACHELORS_DEGREE' ? 'selected' : '' %>>Bachelor's Degree</option>
                            <option value="GRADUATE_CERTIFICATE" <%= filters.educationLevel === 'GRADUATE_CERTIFICATE' ? 'selected' : '' %>>Graduate Certificate</option>
                            <option value="GRADUATE_DIPLOMA" <%= filters.educationLevel === 'GRADUATE_DIPLOMA' ? 'selected' : '' %>>Graduate Diploma</option>
                            <option value="MASTERS_DEGREE" <%= filters.educationLevel === 'MASTERS_DEGREE' ? 'selected' : '' %>>Master's Degree</option>
                            <option value="DOCTORAL_DEGREE" <%= filters.educationLevel === 'DOCTORAL_DEGREE' ? 'selected' : '' %>>Doctoral Degree</option>
                        </select>
                    </label>
                    <label>
                        <span>Salary min</span>
                        <input form="find-job-search-form" type="number" min="0" name="salaryMin" value="<%= filters.salaryMin %>" placeholder="70000" />
                    </label>
                    <label>
                        <span>Salary max</span>
                        <input form="find-job-search-form" type="number" min="0" name="salaryMax" value="<%= filters.salaryMax %>" placeholder="120000" />
                    </label>
                    <label class="find-job-page__skill-filter">
                        <span>Skills</span>
                        <input type="text" placeholder="Type a skill and press Enter" data-filter-skill-input />
                        <span class="find-job-page__skill-chips" data-filter-skill-list></span>
                    </label>
                </section>
                <div data-filter-skill-values>
                    <% (filters.skills || []).forEach((skill) => { %>
                    <input form="find-job-search-form" type="hidden" name="skill" value="<%= skill %>" />
                    <% }) %>
                </div>
                <div class="find-job-page__filter-actions">
                    <% if (activeFilters.length) { %>
                    <a href="/candidate/find-a-job">Clear filters</a>
                    <% } %>
                    <button type="submit" form="find-job-search-form">Apply filters</button>
                </div>
            </section>
        </div>

        <div class="find-job-page__modal" hidden aria-hidden="true" data-job-modal>
            <div class="find-job-page__overlay" data-job-modal-close></div>
            <section class="find-job-page__dialog" role="dialog" aria-modal="true" aria-labelledby="job-detail-title">
                <button class="find-job-page__close" type="button" aria-label="Close job details" data-job-modal-close>
                    <i class="fas fa-times" aria-hidden="true"></i>
                </button>
                <div data-job-detail></div>
            </section>
        </div>
    </section>
</main>
<script>
    window.__findJob = <%- findJobJson %>;
</script>
<script src="/js/global.js"></script>
<script src="/js/find-a-job.js"></script>
</body>
</html>
