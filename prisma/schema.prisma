generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
}

enum Theme {
  DARK
  LIGHT
}

enum WorkingMode {
  REMOTE
  ONSITE
  HYBRID
}

enum UserRole {
  USER
  ADMIN
}

enum CompanyMemberRole {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DELETED
}

enum NotificationType {
  SYSTEM
  USER
  APPLICATION
  RECOMMENDATION
  MEMBERSHIP
}

enum ApplicationStatus {
  APPLIED
  SHORTLISTED
  REJECTED
  WITHDRAWN
  HIRED
}

enum JobType {
  FULL_TIME
  PART_TIME
  CASUAL
  CONTRACT
  INTERNSHIP
}

enum RecommendationTargetType {
  JOB
  CANDIDATE
}

enum EducationQualificationType {
  CERTIFICATE_I
  CERTIFICATE_II
  CERTIFICATE_III
  CERTIFICATE_IV
  DIPLOMA
  ADVANCED_DIPLOMA
  ASSOCIATE_DEGREE
  BACHELORS_DEGREE
  GRADUATE_CERTIFICATE
  GRADUATE_DIPLOMA
  MASTERS_DEGREE
  DOCTORAL_DEGREE
}

enum LanguageFluency {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  NATIVE
}

enum OrganisationType {
  PRIVATE_COMPANY
  PUBLIC_COMPANY
  GOVERNMENT_AGENCY
  UNIVERSITY
  NON_PROFIT
  STARTUP
}

enum CompanyInvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum JobPostingStatus {
  DRAFT
  ACTIVE
  CLOSED
}

model User {
  id String @id @default(uuid())

  email        String @unique
  passwordHash String

  firstName  String
  lastName   String
  phone      String
  avatarHash String?

  role          UserRole      @default(USER)
  accountStatus AccountStatus @default(ACTIVE)
  isMember      Boolean       @default(false)
  theme         Theme         @default(LIGHT)

  lastLoginAt DateTime?

  candidate Candidate?
  employer  Employer?

  ownedCompanies Company[] @relation("CompanyOwner")

  sentNotifications     Notification[] @relation("NotificationSender")
  receivedNotifications Notification[] @relation("NotificationRecipient")

  recommendationLogs RecommendationLog[]
  savedJobs          SavedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([accountStatus])
  @@index([isMember])
  @@index([createdAt])
  @@map("users")
}

model Candidate {
  id     String @id @default(uuid())
  userId String @unique

  education         String?
  major             String?
  yearsOfExperience Int     @default(0)

  workExperience String?
  profileSummary String?

  preferredWorkingMode WorkingMode?
  preferredLocation    String?
  preferredJobType     JobType?

  availability String?
  resumeUrl    String?
  portfolioUrl String?
  linkedinUrl  String?

  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  skills            CandidateSkill[]
  applications      JobApplication[]
  educationRecords  CandidateEducation[]
  experienceRecords CandidateExperience[]
  portfolioLinks    CandidatePortfolioLink[]
  certifications    CandidateCertification[]
  languages         CandidateLanguage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([preferredLocation])
  @@index([preferredWorkingMode])
  @@index([preferredJobType])
  @@index([yearsOfExperience])
  @@index([createdAt])
  @@map("candidates")
}

model CandidateEducation {
  id          String @id @default(uuid())
  candidateId String

  school            String
  qualificationType EducationQualificationType
  major             String?
  fromDate          DateTime?
  toDate            DateTime?
  isCurrent         Boolean                    @default(false)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([qualificationType])
  @@map("candidate_education")
}

model CandidateExperience {
  id          String @id @default(uuid())
  candidateId String

  company   String
  jobTitle  String
  workType  WorkingMode
  location  String?
  duties    String?
  fromDate  DateTime?
  toDate    DateTime?
  isCurrent Boolean     @default(false)

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([workType])
  @@map("candidate_experience")
}

model CandidatePortfolioLink {
  id          String @id @default(uuid())
  candidateId String

  label String
  url   String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@map("candidate_portfolio_links")
}

model CandidateCertification {
  id          String @id @default(uuid())
  candidateId String

  name String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@map("candidate_certifications")
}

model CandidateLanguage {
  id          String @id @default(uuid())
  candidateId String

  name    String
  fluency LanguageFluency

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([candidateId])
  @@index([fluency])
  @@map("candidate_languages")
}

model Employer {
  id     String @id @default(uuid())
  userId String @unique

  user                       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  companies                  EmployerCompany[]
  sentCompanyInvitations     CompanyInvitation[] @relation("CompanyInvitationSender")
  receivedCompanyInvitations CompanyInvitation[] @relation("CompanyInvitationRecipient")
  jobPostings                JobPosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
  @@map("employers")
}

model Company {
  id        String @id @default(uuid())
  ownedById String

  name             String
  email            String?
  phone            String?
  website          String?
  location         String?
  industry         String?
  description      String?
  avatarHash       String?
  brandColour      String?
  size             String?
  organisationType OrganisationType?
  values           String?

  ownedBy     User                @relation("CompanyOwner", fields: [ownedById], references: [id], onDelete: Restrict)
  employers   EmployerCompany[]
  invitations CompanyInvitation[]
  jobPostings JobPosting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name])
  @@index([ownedById])
  @@index([location])
  @@index([industry])
  @@index([organisationType])
  @@index([createdAt])
  @@map("companies")
}

model EmployerCompany {
  id         String            @id @default(uuid())
  employerId String
  companyId  String
  role       CompanyMemberRole @default(USER)

  employer Employer @relation(fields: [employerId], references: [id], onDelete: Cascade)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([employerId, companyId])
  @@index([employerId])
  @@index([companyId])
  @@index([role])
  @@map("employer_companies")
}

model CompanyInvitation {
  id String @id @default(uuid())

  companyId           String
  recipientEmployerId String
  invitedByEmployerId String
  role                CompanyMemberRole       @default(USER)
  status              CompanyInvitationStatus @default(PENDING)

  company           Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  recipientEmployer Employer @relation("CompanyInvitationRecipient", fields: [recipientEmployerId], references: [id], onDelete: Cascade)
  invitedByEmployer Employer @relation("CompanyInvitationSender", fields: [invitedByEmployerId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([recipientEmployerId])
  @@index([invitedByEmployerId])
  @@index([status])
  @@map("company_invitations")
}

model JobPosting {
  id         String @id @default(uuid())
  employerId String
  companyId  String

  jobTitle           String
  companyInformation String
  jobDescription     String

  requiredEducationLevel String
  requiredExperience     Int    @default(0)

  workMode    WorkingMode
  jobLocation String

  salaryMin Int?
  salaryMax Int?
  jobType   JobType?

  closingDate DateTime?
  isActive    Boolean   @default(true)
  status      JobPostingStatus @default(ACTIVE)

  employer     Employer          @relation(fields: [employerId], references: [id], onDelete: Cascade)
  company      Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skills       JobPostingSkill[]
  applications JobApplication[]
  savedBy      SavedJob[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([employerId])
  @@index([companyId])
  @@index([jobLocation])
  @@index([workMode])
  @@index([jobType])
  @@index([requiredExperience])
  @@index([isActive])
  @@index([status])
  @@index([createdAt])
  @@map("job_postings")
}

model Skill {
  id   String @id @default(uuid())
  name String @unique

  candidates  CandidateSkill[]
  jobPostings JobPostingSkill[]

  createdAt DateTime @default(now())

  @@index([name])
  @@map("skills")
}

model CandidateSkill {
  id          String @id @default(uuid())
  candidateId String
  skillId     String

  candidate Candidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  skill     Skill     @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([candidateId, skillId])
  @@index([candidateId])
  @@index([skillId])
  @@map("candidate_skills")
}

model JobPostingSkill {
  id           String @id @default(uuid())
  jobPostingId String
  skillId      String

  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([jobPostingId, skillId])
  @@index([jobPostingId])
  @@index([skillId])
  @@map("job_posting_skills")
}

model JobApplication {
  id          String @id @default(uuid())
  candidateId String
  jobId       String

  status      ApplicationStatus @default(APPLIED)
  coverLetter String?

  candidate Candidate  @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  job       JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([candidateId, jobId])
  @@index([candidateId])
  @@index([jobId])
  @@index([status])
  @@index([createdAt])
  @@map("job_applications")
}

model SavedJob {
  id     String @id @default(uuid())
  userId String
  jobId  String

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  JobPosting @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, jobId])
  @@index([userId])
  @@index([jobId])
  @@index([createdAt])
  @@map("saved_jobs")
}

model Notification {
  id String @id @default(uuid())

  recipientId String
  senderId    String?

  type    NotificationType @default(SYSTEM)
  title   String
  message String

  isRead Boolean   @default(false)
  readAt DateTime?

  recipient User  @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  sender    User? @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([recipientId])
  @@index([senderId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model RecommendationLog {
  id         String                   @id @default(uuid())
  userId     String
  targetType RecommendationTargetType
  targetId   String
  score      Float
  reason     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([targetType])
  @@index([targetId])
  @@index([createdAt])
  @@map("recommendation_logs")
}

model Session {
  sid    String   @id @db.VarChar
  sess   Json
  expire DateTime

  @@index([expire])
  @@map("sessions")
}
